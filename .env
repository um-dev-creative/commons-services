# =============================================================================
# AI Agent Policy Environment — commons-services
# =============================================================================
# This file defines policy flags, rules, restrictions, grants, and build
# configuration consumed by AI agents (Claude Code, GitHub Copilot) and by
# CI scripts.
#
# IMPORTANT: This file contains policy flags and structural placeholders only.
# Secrets (credentials, tokens) must be supplied via CI secrets or a local
# .env.local file that is never committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Project identity
# -----------------------------------------------------------------------------
AI_PROJECT_NAME=commons-services
AI_PROJECT_TYPE=shared-library
AI_PROJECT_ARTIFACT=com.prx:commons-services:0.0.1
AI_PROJECT_IS_RUNNABLE_APP=false
AI_PROJECT_REPO=https://github.com/um-dev-creative/commons-services

# -----------------------------------------------------------------------------
# Source-of-truth pointers
# -----------------------------------------------------------------------------
AI_SOURCE_OF_TRUTH_BUILD=pom.xml
AI_SOURCE_OF_TRUTH_ARCH=AGENTS.md
AI_SOURCE_OF_TRUTH_SHARED_POLICY=AGENTS.md
AI_SOURCE_OF_TRUTH_CLAUDE=CLAUDE.md
AI_SOURCE_OF_TRUTH_COPILOT=.github/copilot-instructions.md
AI_SOURCE_OF_TRUTH_AGENTS_CONFIG=.ai/agents.yml
AI_SOURCE_OF_TRUTH_SKILLS_CONFIG=.ai/skills.yml
AI_SOURCE_OF_TRUTH_ROLES_CONFIG=.ai/roles.yml
AI_SOURCE_OF_TRUTH_CONFS_CONFIG=.ai/confs.yml

# -----------------------------------------------------------------------------
# Rules — invariants that must be preserved in all AI-generated code
# -----------------------------------------------------------------------------

# Library contract rules
AI_RULE_REPO_TYPE=shared-library
AI_RULE_IS_RUNNABLE_APP=false
AI_RULE_REQUIRE_BACKWARD_COMPAT=true
AI_RULE_REQUIRE_SAFE_DEFAULT_METHODS=true
AI_RULE_CRUD_DEFAULT_HTTP_STATUS=NOT_IMPLEMENTED
AI_RULE_PROFILE_IMAGE_SERVICE_FALLBACK=UnsupportedOperationException
AI_RULE_USE_HTTP_STATUS_UTIL=true

# Logging rules
AI_RULE_LOG_TRACE_PROPERTY=prx.logging.trace.enabled
AI_RULE_LOG_INTERCEPTOR_CHAIN=LoggerWebConfigurer->LogInterceptor->LoggingService
AI_RULE_LOG_REQUEST_INTERCEPTOR=RequestBodyInterceptor
AI_RULE_LOG_RESPONSE_INTERCEPTOR=ResponseBodyInterceptor

# MapStruct rules
AI_RULE_MAPSTRUCT_CONFIG=src/main/java/com/prx/commons/services/config/mapper/MapperAppConfig.java
AI_RULE_MAPSTRUCT_COMPONENT_MODEL=SPRING
AI_RULE_MAPSTRUCT_NULL_STRATEGY=SET_TO_NULL

# Constructor injection rule
AI_RULE_USE_CONSTRUCTOR_INJECTION=true
AI_RULE_NO_FIELD_INJECTION=true

# Code style rules
AI_RULE_USE_EXPLICIT_ACCESSORS=true
AI_RULE_NO_LOMBOK=true
AI_RULE_USE_JAVA_RECORDS_FOR_TOS=true
AI_RULE_USE_SLF4J_LOGGER=true
AI_RULE_NO_SYSTEM_OUT=true

# -----------------------------------------------------------------------------
# Restrictions — things AI agents must never do
# -----------------------------------------------------------------------------

# API contract restrictions
AI_RESTRICTION_NO_BREAKING_INTERFACE_SIGNATURES=true
AI_RESTRICTION_NO_ADHOC_HTTP_STATUS_LITERALS=true
AI_RESTRICTION_NO_CONTROLLER_SPECIFIC_LOGGING_BYPASS=true

# Cloudflare R2 restrictions
AI_RESTRICTION_NO_R2_S3_CONFIG_DRIFT=true
AI_RESTRICTION_KEEP_R2_PATH_STYLE=true
AI_RESTRICTION_KEEP_R2_CHUNKED_ENCODING_DISABLED=true
AI_RESTRICTION_KEEP_R2_REGION_AUTO=true
AI_RESTRICTION_NO_R2_CREDENTIAL_LOG=true

# Quality gate restrictions
AI_RESTRICTION_RESPECT_PMD_JACOCO_GATES=true
AI_RESTRICTION_NO_SKIP_VERIFY=true
AI_RESTRICTION_NO_DISABLE_PMD=true
AI_RESTRICTION_NO_REDUCE_JACOCO_THRESHOLDS=true

# Scope restrictions
AI_RESTRICTION_NO_PUBLISH_WITHOUT_GRANT=true
AI_RESTRICTION_NO_DEPLOY_WITHOUT_GRANT=true
AI_RESTRICTION_TREAT_JAVA25_BOOT4_DOCS_AS_MIGRATION_NOT_BASELINE=true
AI_RESTRICTION_NO_SPECULATIVE_ABSTRACTIONS=true
AI_RESTRICTION_NO_UNCOMMITTED_SECRETS=true

# Security restrictions
AI_RESTRICTION_NO_HARDCODED_CREDENTIALS=true
AI_RESTRICTION_NO_COMMIT_ENV_SECRETS=true
AI_RESTRICTION_NO_WEAKEN_SSL_CONFIG=true

# -----------------------------------------------------------------------------
# Grants — things AI agents are explicitly allowed to do
# -----------------------------------------------------------------------------
AI_GRANT_EDIT_SRC_MAIN=true
AI_GRANT_EDIT_SRC_TEST=true
AI_GRANT_EDIT_BUILD_FILES=true
AI_GRANT_CREATE_TESTS=true
AI_GRANT_CREATE_DOCS=true
AI_GRANT_RUN_MAVEN_VERIFY=true
AI_GRANT_RUN_TARGETED_TESTS=true
AI_GRANT_USE_BYTE_BUDDY_WORKAROUND=true
AI_GRANT_ADD_NEW_INTERFACES=true
AI_GRANT_ADD_NEW_PROPERTIES_CLASSES=true
AI_GRANT_REFACTOR_WITHIN_PACKAGE=true
AI_GRANT_ADD_OPENAPI_ANNOTATIONS=true
AI_GRANT_PUBLISH_ARTIFACT=false
AI_GRANT_DEPLOY_CHANGES=false
AI_GRANT_FORCE_PUSH=false
AI_GRANT_MODIFY_CI_PIPELINES=false

# -----------------------------------------------------------------------------
# Build configuration
# -----------------------------------------------------------------------------
AI_CONF_JAVA_VERSION=21
AI_CONF_SPRING_BOOT_VERSION=3.5.8
AI_CONF_SPRING_CLOUD_VERSION=2025.0.1
AI_CONF_MAPSTRUCT_VERSION=1.6.3
AI_CONF_AWS_SDK_VERSION=2.21.0
AI_CONF_JUNIT_VERSION=5.14.1
AI_CONF_MOCKITO_VERSION=5.21.0

AI_CONF_MAVEN_VERIFY_CMD=mvn -DskipITs clean verify
AI_CONF_MAVEN_TEST_CMD=mvn test
AI_CONF_MAVEN_SINGLE_TEST_CMD="mvn test -Dtest={TestClassName}"
AI_CONF_MAVEN_SINGLE_METHOD_CMD="mvn test -Dtest={TestClassName}#{methodName}"
AI_CONF_MAVEN_BYTE_BUDDY_WORKAROUND_CMD="mvn -Dnet.bytebuddy.experimental=true -DskipITs clean test"
AI_CONF_MAVEN_COVERAGE_REPORT_CMD=mvn verify
AI_CONF_MAVEN_PUBLISH_CMD=mvn clean deploy

# -----------------------------------------------------------------------------
# Quality gate configuration
# -----------------------------------------------------------------------------
AI_CONF_PMD_PHASE=test
AI_CONF_PMD_FAILURE_PRIORITY=5
AI_CONF_PMD_RULESET=ruleset.xml
AI_CONF_JACOCO_LINE_MIN=0.80
AI_CONF_JACOCO_BRANCH_MIN=0.50
AI_CONF_JACOCO_REPORT_PATH=target/site/jacoco/jacoco.xml
AI_CONF_COVERAGE_EXCLUDED_PACKAGES=**/config/*,**/loggers/*,**/loggers/interceptor/*,**/mapper/*
AI_CONF_SONAR_PROJECT_KEY=umdc-commons-services
AI_CONF_SONAR_ORGANIZATION=umdevc

# -----------------------------------------------------------------------------
# Agent roster
# -----------------------------------------------------------------------------
AI_AGENTS_DEVELOPER=contracts-architect,logging-flow-specialist,cloudflare-r2-specialist,rest-config-maintainer
AI_AGENTS_SUPPORTING=build-quality-guardian,code-review-auditor,dependency-security-guardian,release-publisher,docs-governance-maintainer

# -----------------------------------------------------------------------------
# Platform compatibility
# -----------------------------------------------------------------------------
AI_COMPAT_COPILOT_ENABLED=true
AI_COMPAT_COPILOT_INSTRUCTIONS_FILE=.github/copilot-instructions.md
AI_COMPAT_CLAUDE_ENABLED=true
AI_COMPAT_CLAUDE_INSTRUCTIONS_FILE=CLAUDE.md
AI_COMPAT_SHARED_POLICY_FILE=AGENTS.md

# -----------------------------------------------------------------------------
# Publishing placeholders — supply via CI secrets or .env.local, never commit
# -----------------------------------------------------------------------------
REPSY_ACCOUNT_USER=
REPSY_ACCOUNT_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
LOGGING_TRACE_ENABLED=false
